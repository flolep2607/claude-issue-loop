#!/usr/bin/env bash
# issue-loop: `git merge` and `git pull` make their commit without running
# post-commit, so an agent that merges the base branch into its own would leave
# the draft PR behind. Same rules as post-commit — agents only, a branch that
# already tracks the remote, never the base — so this only hands over.
# Installed beside another hook as issue-loop-post-merge, its partner is
# issue-loop-post-commit, not the project's own post-commit.
here=$(dirname "$0")
[[ -x "$here/issue-loop-post-commit" ]] && exec "$here/issue-loop-post-commit"
exec "$here/post-commit"
